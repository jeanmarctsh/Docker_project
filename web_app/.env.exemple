# Variables pour application Python (c-à-d myapp)
DB_HOST=value_here(ici ce sera le service de la base de donné qui est donc mysql au niveau du fichier deploy.com)
DB_NAME=value_here
DB_USER=value_here

# Variables pour l'initialisation de MySQL
MYSQL_DATABASE=value_here
MYSQL_USER=value_here

Compte tenu de l'utilisation du secret avec docker swarm, tout fichier qui aura besoin d'un secret
sera nommé avec _FILE à la fin:

exemple:

MYSQL_ROOT_PASSWORD_FILE: /run/secrets/name_of_secret
MYSQL_PASSWORD_FILE: /run/secrets/name_of_secret
DB_PASS_PATH: /run/secrets/name_of_secret

d'où vient cette valeur? (/run/secrets/mysql_secret)

echo "value of secret here" | docker secret create mysql_secret -


